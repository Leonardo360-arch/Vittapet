FROM php:8.2-apache

# Ambiente de desenvolvimento; nenhuma alteração no pacote do InfinityFree.
RUN docker-php-ext-install pdo_mysql mysqli \
    && a2enmod rewrite \
    && sed -ri 's#DocumentRoot /var/www/html#DocumentRoot /var/www/html/public#' /etc/apache2/sites-available/000-default.conf \
    && printf '<Directory /var/www/html/public>\nAllowOverride All\nRequire all granted\n</Directory>\n' > /etc/apache2/conf-available/vittapet-local.conf \
    && a2enconf vittapet-local

WORKDIR /var/www/html
