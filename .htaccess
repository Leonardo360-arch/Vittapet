Options -Indexes
DirectoryIndex public/index.php
RewriteEngine On

# Nunca servir diretamente codigo privado, scripts SQL ou arquivos de desenvolvimento.
RewriteRule ^(config|includes|database|docs|src|storage|tests|deploy)(/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L]
RewriteRule \.(sql|md|log|ini|env|bak|lock)$ - [F,L,NC]

# O InfinityFree usa /htdocs como webroot fixo.
# Mapear /loja.php, /admin/... e /assets/... para /public, sem alterar links da aplicacao.
RewriteRule ^public/ - [L]
RewriteRule ^$ public/index.php [L]
RewriteRule ^(.+)$ public/$1 [L]
